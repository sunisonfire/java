package controlador;

import vista.menu_principal;

public class gestion_menus {

    public void gestion_principal() {

        menu_principal mp = new menu_principal();
        int op;

        do {
            op = mp.menu();

            switch (op) {
                case 1 ->
                    System.out.println("Llamando a opcion menu usuarios");

                case 2 ->
                    System.out.println("Llamando a opcion menu pedidos");

                case 3 ->
                    System.out.println("Aplicacion terminada");

                default ->
                    System.out.println("Opcion no encontrada");
            }

        } while (op != 3);
    }
}
